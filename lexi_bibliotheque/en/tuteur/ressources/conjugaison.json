{
 "titre": "Les temps de l'anglais",
 "temps": [
  {
   "nom": "Présent simple",
   "niveau": 1,
   "forme": "I work / he works",
   "emploi": "habitudes, vérités générales",
   "exemples": [
    "I work every day.",
    "She doesn't work on Sunday.",
    "Do you work here?"
   ],
   "indices": [
    "always",
    "usually",
    "often",
    "every day"
   ]
  },
  {
   "nom": "Présent continu",
   "niveau": 1,
   "forme": "am/is/are + -ing",
   "emploi": "action en cours maintenant",
   "exemples": [
    "I'm working now.",
    "He isn't working today.",
    "Are you working?"
   ],
   "indices": [
    "now",
    "right now",
    "at the moment",
    "Look!"
   ]
  },
  {
   "nom": "Prétérit (passé simple)",
   "niveau": 1,
   "forme": "worked / irrégulier (went)",
   "emploi": "action terminée à un moment précis du passé",
   "exemples": [
    "I worked yesterday.",
    "I didn't work last week.",
    "Did you work in 2020?"
   ],
   "indices": [
    "yesterday",
    "last week",
    "ago",
    "in 2020"
   ]
  },
  {
   "nom": "Futur avec will",
   "niveau": 2,
   "forme": "will + verbe",
   "emploi": "décision immédiate, promesse, prédiction",
   "exemples": [
    "I'll help you.",
    "It won't rain.",
    "Will you come?"
   ],
   "indices": [
    "tomorrow",
    "I think",
    "probably"
   ]
  },
  {
   "nom": "Futur avec be going to",
   "niveau": 2,
   "forme": "am/is/are going to + verbe",
   "emploi": "projet décidé, prédiction visible",
   "exemples": [
    "I'm going to study medicine.",
    "She isn't going to come.",
    "Are you going to travel?"
   ],
   "indices": [
    "next year",
    "tonight"
   ]
  },
  {
   "nom": "Present perfect",
   "niveau": 2,
   "forme": "have/has + participe",
   "emploi": "expérience, résultat présent, depuis",
   "exemples": [
    "I have visited Ghana.",
    "She hasn't finished yet.",
    "Have you ever flown?"
   ],
   "indices": [
    "ever",
    "never",
    "already",
    "yet",
    "just",
    "since",
    "for"
   ]
  },
  {
   "nom": "Prétérit continu",
   "niveau": 3,
   "forme": "was/were + -ing",
   "emploi": "action en cours dans le passé (décor)",
   "exemples": [
    "I was sleeping when you called.",
    "They weren't listening.",
    "Were you working at 8?"
   ],
   "indices": [
    "while",
    "when",
    "at 8 pm yesterday"
   ]
  },
  {
   "nom": "Present perfect continu",
   "niveau": 3,
   "forme": "have/has been + -ing",
   "emploi": "activité qui dure jusqu'à maintenant",
   "exemples": [
    "I've been waiting for an hour.",
    "How long have you been learning English?"
   ],
   "indices": [
    "for",
    "since",
    "how long"
   ]
  },
  {
   "nom": "Past perfect",
   "niveau": 3,
   "forme": "had + participe",
   "emploi": "action antérieure à une autre action passée",
   "exemples": [
    "When I arrived, the bus had left.",
    "She hadn't eaten."
   ],
   "indices": [
    "before",
    "by the time",
    "already"
   ]
  },
  {
   "nom": "Conditionnel",
   "niveau": 3,
   "forme": "would + verbe",
   "emploi": "hypothèse, politesse",
   "exemples": [
    "I would travel if I had money.",
    "Would you like some tea?"
   ],
   "indices": [
    "if",
    "I'd like"
   ]
  },
  {
   "nom": "Futur continu",
   "niveau": 4,
   "forme": "will be + -ing",
   "emploi": "action en cours à un moment futur",
   "exemples": [
    "This time tomorrow I'll be flying."
   ],
   "indices": [
    "this time tomorrow",
    "at 8 tomorrow"
   ]
  },
  {
   "nom": "Futur antérieur (future perfect)",
   "niveau": 4,
   "forme": "will have + participe",
   "emploi": "action terminée avant un moment futur",
   "exemples": [
    "By 2030 I will have finished my studies."
   ],
   "indices": [
    "by",
    "by the time"
   ]
  },
  {
   "nom": "Conditionnel passé",
   "niveau": 4,
   "forme": "would have + participe",
   "emploi": "hypothèse sur le passé",
   "exemples": [
    "I would have come if I had known."
   ],
   "indices": [
    "if + had"
   ]
  },
  {
   "nom": "Passif",
   "niveau": 3,
   "forme": "be + participe",
   "emploi": "l'action compte plus que l'auteur",
   "exemples": [
    "Cocoa is grown here.",
    "The bridge was built in 1958.",
    "It has been cancelled."
   ],
   "indices": [
    "by"
   ]
  }
 ]
}