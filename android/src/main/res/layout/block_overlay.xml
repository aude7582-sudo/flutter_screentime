<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/block_overlay_image"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginBottom="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="Renard Léxi"
            android:scaleType="fitCenter"
            android:src="@drawable/lexi_renard_bloque" />

        <TextView
            android:id="@+id/block_overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Blocked"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/block_overlay_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="This app is unavailable right now."
            android:textSize="18sp" />

        <Button
            android:id="@+id/block_overlay_primary_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Open app"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF8A3D"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/block_overlay_secondary_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Fermer"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:background="@android:color/transparent"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
