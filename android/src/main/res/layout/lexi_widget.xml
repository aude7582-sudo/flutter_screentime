<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Léxi (grand) : temps d'écran du jour, comparaison avec hier,
     ouvertures, appli la plus utilisée et série de jours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lexi_widget_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lexi_widget_fond"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- En-tête : renard, titre, état -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Léxi"
            android:scaleType="fitCenter"
            android:src="@drawable/lexi_renard_bloque" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/lexi_widget_titre"
                android:textColor="#C4B5FD"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lexi_widget_etat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#FB923C"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/lexi_widget_compare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/lexi_widget_puce"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text=""
            android:textColor="#86EFAC"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Temps du jour -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lexi_widget_temps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="…"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lexi_widget_objectif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp"
            android:text=""
            android:textColor="#B8B2D6"
            android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/lexi_widget_barre"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="2dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/lexi_widget_barre" />

    <!-- Trois statistiques -->
    <LinearLayout
        android:id="@+id/lexi_widget_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lexi_widget_stat1"
            style="@style/LexiWidgetStat"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/lexi_widget_stat2"
            style="@style/LexiWidgetStat"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/lexi_widget_stat3"
            style="@style/LexiWidgetStat" />
    </LinearLayout>

    <TextView
        android:id="@+id/lexi_widget_renard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#E9E5FF"
        android:textSize="12sp" />
</LinearLayout>
